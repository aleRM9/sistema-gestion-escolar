# NOTA: Copiar el contenido de este archivo, colocarlo en un archivo .env en la raíz del proyecto y ajustar sus valores
# OJO: Después de las variables para la base de datos, se usan nombres con prefijo DB_ para no chocar con variables del
# sistema (en Windows, USERNAME ya existe y contiene tu usuario de Windows).

# variables que la imagen oficial de PostgreSQL exige para arrancar
POSTGRES_USER=usuario
POSTGRES_PASSWORD=la_contraseña
POSTGRES_DB=gestion_escolar

# Variables para que el backend se comunica con la DB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_escolar
DB_USER=postgres
DB_PASSWORD=la_contraseña
